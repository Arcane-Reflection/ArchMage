# ── ArchMage vendor header (03-02; re-vendored 2026-10-03) ────────────────
# Re-based onto extra's python-gbinder 1.3.1-1 PKGBUILD (waydroid/gbinder-python
# tag tarball, python-build/installer) after the 1.1.2 vendor line broke
# waydroid >=1.5.4's python-gbinder>=1.3.0 requirement in CI. pr12.patch
# dropped: upstream ≥1.3.x builds with setuptools directly.
# Deltas vs extra: arch forced to aarch64 (our CI runner target; extra
# carries x86_64 — ALARM extra covers aarch64 identically), provenance
# comment block. Divergence ledger: overlay/apps/waydroid/DIVERGENCE.md.

pkgname=python-gbinder
_srcname=gbinder-python
pkgver=1.3.1
pkgrel=1
pkgdesc="Python bindings for libgbinder"
arch=('aarch64')
url="https://github.com/waydroid/${_srcname}"
license=('GPL-3.0-only')
depends=('libgbinder>=1.1.40')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'cython')
provides=("${_srcname}")
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
sha512sums=('85c78ad76cc9403b09be1fb96424f529aa0cee7a570bc5cb7a4515a4746b006998c6b32a6d59c9931846d825c99ae59e71e2e907940adc3ae13415d6655d5f00')

build() {
	cd "${_srcname}-${pkgver}/"
	python -m build --wheel --no-isolation
}

package() {
	cd "${_srcname}-${pkgver}/"
	python -m installer --destdir="${pkgdir}" dist/*.whl
}
