# ArchMage CN APN preset — 中国联通 (3gnet)。CN-03 / TELE-01。
# 只读系统连接(/usr/lib/NetworkManager/system-connections/,NM 自动
# 发现);autoconnect=false:预设不自动连接,防插错卡连错网,按运营商
# 手动启用(设置 → Mobile Network,或 nmcli con up)。
[connection]
id=中国联通 (3gnet)
uuid=8e0b1a23-6a7d-4b4c-95e0-2d3e4c5b6a58
type=gsm
autoconnect=false

[gsm]
apn=3gnet

[ipv4]
method=auto

[ipv6]
method=auto
