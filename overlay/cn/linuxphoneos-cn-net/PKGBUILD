# Maintainer: linuxphoneOS contributors
#
# CN network defaults for linuxphoneOS (CN-01): NTP, DNS, connectivity
# check — all reachable from CN networks by default.
#
# Overlay-only (STRATEGY §4): drop-in configuration only, never overwrites
# upstream whole files; depends on upstream packages, forks nothing.

pkgname=linuxphoneos-cn-net
pkgver=1
pkgrel=1
pkgdesc='CN network defaults for linuxphoneOS: aliyun NTP, CN public DNS, CN-reachable connectivity check'
arch=(any)
url='https://github.com/uMaj35ty/linuxphoneOS'
license=('MIT')
depends=('systemd' 'networkmanager')
source=('timesyncd-cn.conf'
        'resolved-cn.conf'
        'nm-connectivity-cn.conf')
sha256sums=('1b1e486c6e65b0b3e2e8870bea7e804995f5dbf5879f3265cb257c4afd69a980'
            '225f00c3f0ffde5b6fcd30e1f7461f03724cdadfe924801a236b112c2cc60d2a'
            '673126b871cdadbc21fa11887d613d34b6ef45ed4b84a7afd3b041530267f090')
backup=('etc/systemd/timesyncd.conf.d/90-linuxphoneos-cn.conf'
        'etc/systemd/resolved.conf.d/90-linuxphoneos-cn.conf'
        'etc/NetworkManager/conf.d/90-linuxphoneos-cn.conf')

package() {
    cd "$srcdir"
    install -Dm644 timesyncd-cn.conf  "$pkgdir/etc/systemd/timesyncd.conf.d/90-linuxphoneos-cn.conf"
    install -Dm644 resolved-cn.conf    "$pkgdir/etc/systemd/resolved.conf.d/90-linuxphoneos-cn.conf"
    install -Dm644 nm-connectivity-cn.conf "$pkgdir/etc/NetworkManager/conf.d/90-linuxphoneos-cn.conf"
}
