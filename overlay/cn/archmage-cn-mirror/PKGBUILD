# Maintainer: ArchMage contributors
#
# CN mirror defaults for ArchMage (CN-01).
#
# Overlay-only (STRATEGY §4): this package carries configuration only and
# depends on upstream packages; it does not fork or replace any upstream
# PKGBUILD or package.
#
# NOTE on /etc/pacman.d/mirrorlist: that path is owned by the upstream
# `pacman-mirrorlist` package on Arch/ALARM, so this package must not ship
# it directly (hard `pacman -U` file conflict). The canonical mirrorlists
# are package-owned under /etc/pacman.d/archmage/ (backup-protected so
# local edits survive upgrades) and the install scriptlet applies the
# factory default to /etc/pacman.d/mirrorlist with pacnew-safe semantics.

pkgname=archmage-cn-mirror
pkgver=1
pkgrel=1
pkgdesc='CN pacman mirror defaults for ArchMage: TUNA/USTC mirrorlists for Arch Linux ARM and archlinuxcn'
arch=(any)
url='https://github.com/uMaj35ty/ArchMage'
license=('MIT')
depends=('pacman')
install=archmage-cn-mirror.install
source=('archmage-mirrorlist')
sha256sums=('684a69d64b47916b68c54ec4a2b7ab9dff5cc8f98da6774b6f3c8518d92728df')
backup=('etc/pacman.d/archmage/mirrorlist'
        'etc/pacman.d/archmage/mirrorlist-archlinuxcn')

package() {
    cd "$srcdir"

    # Split the single mirrorlist source at the BEGIN/END markers.
    awk '/^# ---- BEGIN archlinuxarm ----$/{f=1;next} /^# ---- END archlinuxarm ----$/{f=0} f' \
        archmage-mirrorlist > mirrorlist
    awk '/^# ---- BEGIN archlinuxcn ----$/{f=1;next} /^# ---- END archlinuxcn ----$/{f=0} f' \
        archmage-mirrorlist > mirrorlist-archlinuxcn

    install -Dm644 mirrorlist "$pkgdir/etc/pacman.d/archmage/mirrorlist"
    install -Dm644 mirrorlist-archlinuxcn "$pkgdir/etc/pacman.d/archmage/mirrorlist-archlinuxcn"
}
