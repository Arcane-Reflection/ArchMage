*.src.tar.gz
*.sig
src/
pkg/

# local test artifacts
test/build/
test/results/

# CI / local makepkg cache
.cache/

# discipline checker default output when run against the rootfs-bad fixture
test/fixtures/discipline.json

# archmage-keyring: the stable public keyring is ceremony output
# (tools/repo/export-keyring.sh on the maintainer host) — never committed
# pre-ceremony, never in any automation (docs/REPO-CHANNELS.md)
overlay/core/archmage-keyring/archmage.gpg

# bootstrap/ kupferbootstrap working tree (images, pkgbuilds, caches)
bootstrap/.work/

# flash/op6 device backup archives (per-serial calibration data — NEVER commit)
flash/op6/backups/

# flash/op6 fetched/verified image cache (test bench bypass + fetch_image output)
flash/op6/.work/

# flash harness test bench results (mock logs, ephemeral gpg homes)
flash/op6/tests/.results/

# nvchecker runtime artifacts (04-01): synced alpm dbpaths, the token
# keyfile (T-04-02 — generated per-run from GITHUB_TOKEN, deleted on exit)
# and the check-result store (nvtake target; baseline is oldver.txt)
tools/nvchecker/alarm-db/
tools/nvchecker/arch-db/
tools/nvchecker/keyfile
tools/nvchecker/newver.txt
.keys/

# internal planning & agent context (not for the public repo)
.planning/
.claude/
STRATEGY.md

# updpkgsums/makepkg downloaded sources at package-dir root
overlay/apps/*/*.tar.gz
overlay/apps/waydroid/waydroid/

# VM host-side runtime assets (built/curated per-host, not source):
# fixed virglrenderer build, noVNC checkout, serial/monitor sockets,
# VNC captures, libs narrow the reproducible recipe to the script itself.
test/build/x86_64/virgl-fixed/
test/build/x86_64/noVNC/
test/build/x86_64/novnc-deps/
test/build/x86_64/vm-*.sock
